% ieeeaccess.sty
%
% An IEEE-Access-style LaTeX package, built to sit alongside acl.sty and
% arxiv.sty in the same asset collection.
%
% This package is activated by adding
%
%    \usepackage{ieeeaccess}
%
% to your LaTeX file. It is designed to be used with the standard
% \documentclass{article} (NOT IEEEtran), and reproduces the general look
% of an IEEE Access paper: two-column layout, Open Access banner, DOI /
% received-date strip, Digital Object Identifier footer, and the small
% caps section styling IEEE journals use. It does not depend on, and does
% not reproduce, IEEE's own IEEEtran.cls.
%
% Options:
%   \usepackage[doi=10.1109/ACCESS.2026.0000000]{ieeeaccess}
%   \usepackage[final]{ieeeaccess}   (default) - normal, numbered pages
%   \usepackage[review]{ieeeaccess}  - adds line numbers for review copies

\NeedsTeXFormat{LaTeX2e}
\typeout{IEEE Access style (unofficial, article-based)}

\RequirePackage{xcolor}
\RequirePackage{graphicx}
\RequirePackage[T1]{fontenc}
\RequirePackage{url}

%% ------------------------------------------------------------------
%% Options
%% ------------------------------------------------------------------
\newif\ifieeeaccess@review
\ieeeaccess@reviewfalse
\DeclareOption{review}{\ieeeaccess@reviewtrue}
\DeclareOption{final}{\ieeeaccess@reviewfalse}
\ExecuteOptions{final}
\ProcessOptions\relax

\ifieeeaccess@review
  \RequirePackage[switch,mathlines]{lineno}
\fi

%% ------------------------------------------------------------------
%% Page geometry - IEEE Access uses a wide two-column US-letter layout
%% ------------------------------------------------------------------
\RequirePackage[letterpaper,
  top=1.9cm, bottom=2.2cm, left=1.5cm, right=1.5cm,
  headheight=14pt, headsep=10pt, columnsep=0.6cm]{geometry}

\setlength\columnsep{0.6cm}
\twocolumn
\flushbottom
\sloppy

%% ------------------------------------------------------------------
%% Colors - IEEE Access house blue/orange
%% ------------------------------------------------------------------
\definecolor{ieeeaccessblue}{RGB}{0,84,159}
\definecolor{ieeeaccessorange}{RGB}{242,101,34}
\definecolor{ieeeaccessgray}{RGB}{88,88,90}

%% ------------------------------------------------------------------
%% Fonts - Times-like, matching IEEE house style
%% ------------------------------------------------------------------
\renewcommand{\rmdefault}{ptm}
\renewcommand{\sfdefault}{phv}

%% ------------------------------------------------------------------
%% Metadata commands
%% ------------------------------------------------------------------
\newcommand{\ieeeaccessdoi}[1]{\def\@ieeeaccessdoi{#1}}
\ieeeaccessdoi{10.1109/ACCESS.2026.0000000}

\newcommand{\ieeeaccessvolume}[1]{\def\@ieeeaccessvolume{#1}}
\ieeeaccessvolume{XX}

\newcommand{\ieeeaccessdatereceived}[1]{\def\@ieeeaccessdatereceived{#1}}
\ieeeaccessdatereceived{Month XX, XXXX}

\newcommand{\ieeeaccessdatepublished}[1]{\def\@ieeeaccessdatepublished{#1}}
\ieeeaccessdatepublished{Month XX, XXXX}

\newcommand{\ieeeaccessdoiline}{%
  Digital Object Identifier \@ieeeaccessdoi
}

%% ------------------------------------------------------------------
%% Corresponding author + funding note (goes in a footnote on p.1)
%% ------------------------------------------------------------------
\newcommand{\corrauthor}[1]{\def\@corrauthor{#1}}
\corrauthor{}
\newcommand{\ieeeaccessfunding}[1]{\def\@ieeeaccessfunding{#1}}
\ieeeaccessfunding{}

%% ------------------------------------------------------------------
%% Headers / footers
%% ------------------------------------------------------------------
\RequirePackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0.4pt}

\newcommand{\shortauthorlist}[1]{\def\@shortauthorlist{#1}}
\shortauthorlist{}
\newcommand{\shortpapertitle}[1]{\def\@shortpapertitle{#1}}
\shortpapertitle{}

\fancyhead[L]{\footnotesize\color{ieeeaccessgray}%
  \ifx\@shortauthorlist\@empty Author \emph{et al.} \else \@shortauthorlist\fi:
  \ifx\@shortpapertitle\@empty Preparation of Papers for IEEE Access
  \else \@shortpapertitle\fi}
\fancyfoot[L]{\footnotesize\color{ieeeaccessgray}VOLUME~\@ieeeaccessvolume, \the\year}
\fancyfoot[R]{\footnotesize\color{ieeeaccessgray}\thepage}
\fancyfoot[C]{\footnotesize\color{ieeeaccessgray}\ieeeaccessdoiline}

%% ------------------------------------------------------------------
%% Open-access banner on the first page
%% ------------------------------------------------------------------
\newcommand{\@ieeeaccessbanner}{%
  \begin{minipage}{\textwidth}
    \colorbox{ieeeaccessblue}{%
      \parbox{\textwidth}{%
        \centering\color{white}\sffamily\bfseries\small
        \vspace{2pt}
        Received \@ieeeaccessdatereceived; accepted for publication; date of
        current version \@ieeeaccessdatepublished.\\[2pt]
        \ieeeaccessdoiline
        \vspace{2pt}
      }%
    }\\[4pt]
    {\small\itshape\color{ieeeaccessgray}
      This work is licensed under a Creative Commons Attribution 4.0
      License. For more information, see
      \url{https://creativecommons.org/licenses/by/4.0/}}
  \end{minipage}
  \par\vspace{8pt}
}

%% ------------------------------------------------------------------
%% Title block
%% ------------------------------------------------------------------
\def\@ieeeaccesscategory{}
\newcommand{\ieeeaccesscategory}[1]{\def\@ieeeaccesscategory{#1}}

\renewcommand{\maketitle}{%
  \twocolumn[{%
    \@ieeeaccessbanner
    \begin{center}
      {\Large\bfseries\sffamily\color{ieeeaccessblue} \@title \par}
      \vspace{10pt}
      {\normalsize \@author \par}
      \vspace{6pt}
    \end{center}
    \ifx\@corrauthor\@empty\else
      {\small\noindent\textbf{Corresponding author:} \@corrauthor.\par}
    \fi
    \ifx\@ieeeaccessfunding\@empty\else
      {\small\noindent\textbf{This work was supported by} \@ieeeaccessfunding.\par}
    \fi
    \vspace{10pt}
  }]%
  \ifieeeaccess@review\linenumbers\fi
  \thispagestyle{fancy}
}

%% ------------------------------------------------------------------
%% Abstract + Index Terms (IEEE calls keywords "Index Terms")
%% ------------------------------------------------------------------
\renewenvironment{abstract}{%
  \noindent{\bfseries\sffamily ABSTRACT\quad}\ignorespaces
}{\par\vspace{6pt}}

\newenvironment{IEEEkeywords}{%
  \par\noindent{\bfseries\sffamily INDEX TERMS\quad}\ignorespaces
}{\par\vspace{10pt}}
% Backwards-compatible alias
\newenvironment{indexterms}{\begin{IEEEkeywords}}{\end{IEEEkeywords}}

%% ------------------------------------------------------------------
%% Section styling - IEEE Access uses small caps, roman numerals for
%% top-level sections
%% ------------------------------------------------------------------
\RequirePackage{enumitem}

\renewcommand\section{\@startsection{section}{1}{\z@}%
  {3pt plus 1pt minus 1pt}{2pt plus 1pt}%
  {\centering\normalsize\scshape\bfseries}}
\renewcommand\subsection{\@startsection{subsection}{2}{\z@}%
  {3pt plus 1pt minus 1pt}{1pt}%
  {\normalsize\itshape}}
\renewcommand\subsubsection{\@startsection{subsubsection}{3}{\z@}%
  {2pt plus 1pt minus 1pt}{1pt}%
  {\normalsize\itshape}}

% Roman-numeral section counters, IEEE style: "I. INTRODUCTION"
\renewcommand{\thesection}{\Roman{section}}
\renewcommand{\thesubsection}{\Alph{subsection}.}

%% ------------------------------------------------------------------
%% Captions
%% ------------------------------------------------------------------
\RequirePackage{caption}
\captionsetup[figure]{name=FIGURE,labelsep=period,font=small,justification=centering}
\captionsetup[table]{name=TABLE,labelsep=period,font={small,sc},justification=centering}

%% ------------------------------------------------------------------
%% Bibliography - numeric IEEE style, bracketed
%% ------------------------------------------------------------------
\renewcommand\@biblabel[1]{[#1]}
\providecommand{\bibsection}{}
\renewcommand{\bibsection}{%
  \section*{REFERENCES}
}
\renewcommand{\refname}{REFERENCES}

%% ------------------------------------------------------------------
%% Author biography block (IEEE Access papers end with photo + bio
%% for each author)
%% ------------------------------------------------------------------
\newlength{\ieeeaccessbiophotowidth}
\setlength{\ieeeaccessbiophotowidth}{1in}

\newcommand{\ieeeaccessbio}[3][]{%
  % #1 = optional photo file, #2 = author name, #3 = bio text
  \par\vspace{6pt}\noindent
  \begin{minipage}[t]{\ieeeaccessbiophotowidth}
    \ifx\relax#1\relax
      \rule{0.9in}{1.15in}% placeholder box if no photo given
    \else
      \includegraphics[width=0.9in]{#1}
    \fi
  \end{minipage}%
  \hfill
  \begin{minipage}[t]{\dimexpr\columnwidth-\ieeeaccessbiophotowidth-8pt\relax}
    \small\textbf{#2} #3
  \end{minipage}
  \par\vspace{6pt}
}

\endinput
